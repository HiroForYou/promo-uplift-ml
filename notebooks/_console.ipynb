      "source": "\"\"\"Reconfigura stdout a UTF-8 (evita UnicodeEncodeError con emojis/acentos en consolas Windows cp1252).\"\"\"\nimport sys\n\n\ndef reconfigure_stdout() -> None:\n    if hasattr(sys.stdout, \"reconfigure\"):\n        sys.stdout.reconfigure(encoding=\"utf-8\", errors=\"replace\")\n",
