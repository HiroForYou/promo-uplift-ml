# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ── Virtual environments ──────────────────────────────────────────────────────
ml_env/
.venv/
venv/
env/

# ── Secrets and local configuration ───────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ── Data (never versioned) ────────────────────────────────────────────────────
data/*
!data/.gitkeep

# ── Model artifacts (regenerated by src/tune.py and src/train.py) ─────────────
models/*
!models/.gitkeep

# ── Pipeline outputs (regenerated by steps 3-9) ───────────────────────────────
reports/*
!reports/.gitkeep

# ── Deploy packages (regenerated by scripts/package_deploy.py) ───────────────
dist/*
!dist/.gitkeep
*.zip
*.tar.gz

# ── ETL local output ──────────────────────────────────────────────────────────
deploy/ETL/output/

# ── Node / Office ─────────────────────────────────────────────────────────────
node_modules/
*.docx
~$*.docx

# ── Local-only: client documents, SQL against the client data lake, drafts ────
_local/

# ── IDE / OS ──────────────────────────────────────────────────────────────────
.vscode/
.idea/
.claude/
*.swp
.DS_Store
Thumbs.db
desktop.ini
