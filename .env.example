# ─────────────────────────────────────────────────────────────────
# promo-uplift-ml: variables de entorno
# Copia este archivo a .env y completa los valores reales.
# .env está en .gitignore — nunca lo commitees.
# ─────────────────────────────────────────────────────────────────

# ── AWS ──────────────────────────────────────────────────────────
AWS_DEFAULT_REGION=us-west-2

# Credenciales (omitir si usas IAM Role / AWS SSO / instance profile)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# ── SageMaker ────────────────────────────────────────────────────
# ARN del rol de ejecución — requerido por deploy/pipeline_def.py
SAGEMAKER_ROLE_ARN=arn:aws:iam::ACCOUNT_ID:role/ROLE_NAME

# ── Buckets S3 ───────────────────────────────────────────────────
# Bucket de trabajo del proyecto (code/, data/, models/, reports/, publish/)
PROMO_S3_BUCKET=my-promo-bucket

# Buckets de datos crudos SAP leídos por deploy/ETL
RAW_BUCKET_SALES=my-raw-sales
RAW_BUCKET_INVENTORY=my-raw-inventory
RAW_BUCKET_PRICES=my-raw-prices
RAW_BUCKET_MASTERDATA=my-raw-masterdata

# ── Rutas S3 → config.py las lee como SM_* al correr en SageMaker ──
# En local no hace falta setearlas (config.py usa ROOT/data, ROOT/models, etc.)
# Útil para apuntar scripts locales directamente al bucket de producción.

# Datos de entrada (train-set-features.csv)
SM_CHANNEL_TRAIN=s3://<PROMO_S3_BUCKET>/m1/data

# Artefactos del modelo (.pkl, tune_meta.json, train_meta.json)
SM_MODEL_DIR=s3://<PROMO_S3_BUCKET>/m1/models

# Base de reportes internos del pipeline (cv/, scoring/, elasticity/, shap/)
SM_OUTPUT_DATA_DIR=s3://<PROMO_S3_BUCKET>/m1/reports

# Destino de publicación → DataOps/Snowflake lee de aquí
SM_PUBLISH_DIR=s3://<PROMO_S3_BUCKET>/m1/publish

# ── Referencia completa del bucket ───────────────────────────────
# s3://<PROMO_S3_BUCKET>/m1/
#   code/
#     sourcedir.tar.gz              ← sube deploy/deploy_sm.py
#   data/
#     train-set-features.csv        ← SM_CHANNEL_TRAIN
#   models/
#     tune_meta.json
#     xgb_base.pkl                  ← CHAMPION_MODEL (config.py)
#     lgbm_tuned.pkl
#     train_meta.json
#   reports/
#     cv/
#       cv_report.json
#     scoring/
#       scoring_output.csv
#       staging_output.parquet
#       dryrun_report.json
#     elasticity/
#       promo_elasticity_curves.parquet
#     shap/
#       shap_importance.csv
#   publish/                        ← SM_PUBLISH_DIR
#     PROMO_PREDICTIONS/
#       staging_output.parquet          → Snowflake: PROMO_PREDICTIONS
#     PROMO_ELASTICITY_CURVES/
#       promo_elasticity_curves.parquet  → Snowflake: PROMO_ELASTICITY_CURVES
